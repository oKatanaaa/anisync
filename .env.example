# Shared app settings, loaded by Compose and npm start.
# Copy to .env to customize. Shell environment variables take precedence.

# Shared login password. Required for Compose; choose your own before deploying.
PASSWORD=change-this-password

# Published host address (Compose only) and port.
# Use 0.0.0.0 to allow direct access from your private LAN.
HOST_BIND=127.0.0.1
PORT=8080
MAX_VIEWERS=3

# Video folder on the Docker host. Create it before starting Compose.
# Absolute paths work too, e.g. /srv/videos or D:/Videos on Windows.
MEDIA_DIR=./media

# Prepared video, HLS, subtitles, posters and saved room state on the host.
# Create this folder too; keep it separate from MEDIA_DIR.
CACHE_DIR=./cache

# Media preparation (the default container uses CPU encoding).
ENCODER=x264
SUBTITLES=bake
MAX_HEIGHT=1080
ALT_HEIGHTS=720
MAX_VIDEO_KBPS=3500
CRF=21
X264_PRESET=medium

# Upload limit per file: 12 GiB. Timeout is in milliseconds; 0 disables it.
MAX_UPLOAD_BYTES=12884901888
UPLOAD_REQUEST_TIMEOUT=0

# Scheduled playback lead times, in milliseconds.
START_DELAY_MS=1200
SEEK_DELAY_MS=700
